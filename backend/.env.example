APP_NAME=PaperPilot API
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=data
MAX_UPLOAD_MB=25
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Default local inference. Install Ollama and pull manually: ollama pull qwen2.5:3b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=90
# Optional paid provider; backend-only, never NEXT_PUBLIC_.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
